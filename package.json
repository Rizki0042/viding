{
  "name": "minimarket-elektronik",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.local -- prisma generate --schema prisma/schema.prisma",
    "db:push": "dotenv -e .env.local -- prisma db push --schema prisma/schema.prisma",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.js",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4"
  }
}
